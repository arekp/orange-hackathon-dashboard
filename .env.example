# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.

# Token fine-grained PAT, tylko do odczytu, dla organizacji hackatonu:
#   Repository access: All repositories
#   Permissions: Contents: Read, Pull requests: Read, Metadata: Read
GITHUB_TOKEN=github_pat_xxx
GITHUB_ORG=nazwa-organizacji

# Opcjonalny filtr repozytoriów zespołów (puste = wszystkie repo organizacji)
REPO_PREFIX=
REPO_TOPIC=

# Czas hackatonu (ISO 8601, ze strefą czasową)
HACKATHON_START=2026-11-14T10:00:00+01:00
HACKATHON_END=2026-11-16T10:00:00+01:00
EVENT_NAME=Orange Hackathon
TIMEZONE=Europe/Warsaw

# Co ile sekund pobierać dane z GitHuba (600 = 10 min)
POLL_INTERVAL_SECONDS=600

# Linie kodu liczone z listy plików (dokładniejsze, 1 zapytanie REST na nowy commit)
FILE_LEVEL_STATS=true
# Commit powyżej tylu zmienionych linii jest odstający i nie liczy się do linii kodu
OUTLIER_LINES=5000
# Dodatkowe wykluczenia plików (wzorce glob, po przecinku)
EXCLUDE_PATTERNS=

PORT=8080
